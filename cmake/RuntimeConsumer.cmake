# Include after project(... LANGUAGES C CXX), with TB_RUNTIME_ROOT set.
if(NOT DEFINED TB_RUNTIME_ROOT)
    message(FATAL_ERROR "Set TB_RUNTIME_ROOT to the verified extracted bundle")
endif()
find_package(Python3 3.11 COMPONENTS Interpreter REQUIRED)
if(NOT DEFINED TB_RUNTIME_EXPECTED_SOURCE)
    message(FATAL_ERROR "Set TB_RUNTIME_EXPECTED_SOURCE to the selected source commit")
endif()
execute_process(COMMAND "${Python3_EXECUTABLE}" "${TB_RUNTIME_ROOT}/tools/runtime_bundle.py" verify
    "${TB_RUNTIME_ROOT}" --source "${TB_RUNTIME_EXPECTED_SOURCE}" COMMAND_ERROR_IS_FATAL ANY)
if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "Runtime requires an x64 target")
endif()
file(READ "${TB_RUNTIME_ROOT}/manifest.json" tb_manifest)
string(JSON tb_system GET "${tb_manifest}" build system)
if(NOT CMAKE_SYSTEM_NAME STREQUAL tb_system)
    message(FATAL_ERROR "Runtime OS mismatch")
endif()
string(JSON tb_host GET "${tb_manifest}" host_library)
if(TB_RUNTIME_CPU_SMOKE)
    string(JSON tb_boot GET "${tb_manifest}" cpu_boot_library)
else()
    string(JSON tb_boot GET "${tb_manifest}" boot_library)
endif()
string(JSON tb_runtime GET "${tb_manifest}" runtime_library)
string(JSON tb_abi GET "${tb_manifest}" abi_sha256)
file(SHA256 "${TB_RUNTIME_ROOT}/include/ppu_recomp.h" tb_actual_abi)
if(NOT tb_abi STREQUAL tb_actual_abi)
    message(FATAL_ERROR "Runtime ABI header mismatch")
endif()
string(JSON tb_compiler GET "${tb_manifest}" build compiler_id)
string(JSON tb_version GET "${tb_manifest}" build compiler_version)
if(NOT CMAKE_CXX_COMPILER_ID STREQUAL tb_compiler OR NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL tb_version)
    message(FATAL_ERROR "Runtime compiler ABI mismatch: require ${tb_compiler} ${tb_version}")
endif()
add_library(TankBattlesRuntime INTERFACE)
target_include_directories(TankBattlesRuntime INTERFACE
    "${TB_RUNTIME_ROOT}/include" "${TB_RUNTIME_ROOT}/sdk/include"
    "${TB_RUNTIME_ROOT}/sdk/runtime/spu" "${TB_RUNTIME_ROOT}/sdk/runtime/platform"
    "${TB_RUNTIME_ROOT}/sdk/runtime/memory" "${TB_RUNTIME_ROOT}/sdk/libs/video")
if(WIN32)
    string(JSON tb_msvc GET "${tb_manifest}" build msvc_version)
    string(JSON tb_frontend GET "${tb_manifest}" build compiler_frontend)
    if(NOT CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL tb_frontend OR NOT MSVC_VERSION STREQUAL tb_msvc)
        message(FATAL_ERROR "Runtime Microsoft toolchain ABI mismatch")
    endif()
    if(NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreaded")
        message(FATAL_ERROR "Runtime requires the Release static CRT: MultiThreaded")
    endif()
    file(GLOB tb_dependency_libraries "${TB_RUNTIME_ROOT}/deps/lib/*.lib")
    if(NOT tb_dependency_libraries)
        message(FATAL_ERROR "Runtime dependency libraries are missing")
    endif()
    target_link_options(TankBattlesRuntime INTERFACE "/WHOLEARCHIVE:${TB_RUNTIME_ROOT}/lib/${tb_host}")
    target_link_libraries(TankBattlesRuntime INTERFACE "${TB_RUNTIME_ROOT}/lib/${tb_boot}" "${TB_RUNTIME_ROOT}/lib/${tb_host}" "${TB_RUNTIME_ROOT}/lib/${tb_runtime}"
        ${tb_dependency_libraries} ws2_32 iphlpapi ole32 bcrypt crypt32 dbghelp user32 gdi32 winmm imm32 oleaut32 version setupapi shell32 advapi32 uuid d3d12 dxgi dxguid cfgmgr32 hid)
    target_compile_definitions(TankBattlesRuntime INTERFACE NOMINMAX _CRT_SECURE_NO_WARNINGS)
else()
    find_package(SDL2 CONFIG REQUIRED)
    find_package(glslang CONFIG REQUIRED)
    find_package(Threads REQUIRED)
    find_package(CURL 7.77 REQUIRED)
    target_link_libraries(TankBattlesRuntime INTERFACE "${TB_RUNTIME_ROOT}/lib/${tb_boot}" "-Wl,--whole-archive" "${TB_RUNTIME_ROOT}/lib/${tb_host}" "-Wl,--no-whole-archive"
        "${TB_RUNTIME_ROOT}/lib/${tb_runtime}" glslang::glslang glslang::SPIRV SDL2::SDL2 Threads::Threads CURL::libcurl ${CMAKE_DL_LIBS} m)
    if(TARGET glslang::glslang-default-resource-limits)
        target_link_libraries(TankBattlesRuntime INTERFACE glslang::glslang-default-resource-limits)
    endif()
endif()
